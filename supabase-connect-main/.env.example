# Copy to .env.local for local development. Never commit live values.
VITE_APP_ENV=development
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Preferred for new Supabase projects when available. If set, this takes precedence over VITE_SUPABASE_ANON_KEY.
# VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Required in staging and production. Must equal the ref in VITE_SUPABASE_URL.
VITE_EXPECTED_SUPABASE_PROJECT_REF=your-project-ref
# Optional feature flags.
VITE_ENABLE_PLEDGE_REALTIME=false
