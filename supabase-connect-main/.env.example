# Copy to .env.local for local development. Never commit live values.
VITE_APP_ENV=development
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Required in staging and production. Must equal the ref in VITE_SUPABASE_URL.
VITE_EXPECTED_SUPABASE_PROJECT_REF=your-project-ref
# Set this in both Netlify contexts to protect against project swaps.
VITE_PRODUCTION_SUPABASE_PROJECT_REF=your-production-project-ref
