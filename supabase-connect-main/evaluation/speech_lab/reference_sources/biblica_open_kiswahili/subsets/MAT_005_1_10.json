  ],
  "verses": [
    {
      "verse": 1,
      "text": "Basi Isa alipoona makundi ya watu, alipanda mlimani akaketi chini, nao wanafunzi wake wakamjia."
    },
    {
      "verse": 2,
      "text": "Ndipo akaanza kuwafundisha, akisema:"
    },
    {
      "verse": 3,
      "text": "“Heri walio maskini wa roho, maana ufalme wa mbinguni ni wao."
    },
    {
      "verse": 4,
      "text": "Heri wale wanaohuzunika, maana hao watafarijiwa."
    },
    {
      "verse": 5,
      "text": "Heri walio wapole, maana hao watairithi nchi."
    },
    {
      "verse": 6,
      "text": "Heri wenye njaa na kiu ya haki, maana hao watatoshelezwa."
    },
    {
      "verse": 7,
      "text": "Heri wenye huruma, maana hao watapata rehema."
    },
    {
      "verse": 8,
      "text": "Heri walio na moyo safi, maana hao watamwona Mungu."
    },
    {
      "verse": 9,
      "text": "Heri walio wapatanishi, maana hao wataitwa wana wa Mungu."
    },
    {
      "verse": 10,
      "text": "Heri wanaoteswa kwa sababu ya haki, maana ufalme wa mbinguni ni wao."
    }
  ],
  "source_chapter_id": "MAT_005",
