  "verses": [
    {
      "verse": 1,
      "start": 11.365,
      "end": 56.9055,
      "confidence": 0.0,
      "duration": 45.5405,
      "word_count": 15,
      "text": "Basi palikuwa na mtu mmoja Farisayo, jina lake Nikodemo, mmoja wa Baraza la Wayahudii lililotawala."
    },
    {
      "verse": 2,
      "start": 56.9055,
      "end": 57.626,
      "confidence": 0.0,
      "duration": 0.7204999999999941,
      "word_count": 49,
      "text": "Huyu alimjia Yesu usiku akamwambia, “Rabi, tunajua kuwa wewe ni mwalimu uliyetumwa na Mungu, kwa maana hakuna mtu awezaye kufanya miujiza hii uifanyayo wewe, kama Mungu hayuko pamoja naye.” Sanhedrin ambalo lilikuwa ndilo Baraza la juu kabisa la utawala wa Kiyahudi, lililoundwa na wazee 70 pamoja na kuhani mkuu."
    },
    {
      "verse": 3,
      "start": 57.626,
      "end": 57.806,
      "confidence": 0.0,
      "duration": 0.17999999999999972,
      "word_count": 17,
      "text": "Yesu akamjibu, “Amin, amin nakuambia, hakuna mtu anayeweza kuuona Ufalme wa Mungu kama hajazaliwa mara ya pili.”"
    },
    {
      "verse": 4,
      "start": 57.806,
      "end": 58.1565,
      "confidence": 0.0,
      "duration": 0.3505000000000038,
      "word_count": 21,
      "text": "Nikodemo akauliza, “Awezaje mtu kuzaliwa wakati akiwa mzee? Hakika hawezi kuingia mara ya pili kwenye tumbo la mama yake ili azaliwe!”"
    },
    {
      "verse": 5,
      "start": 58.1565,
      "end": 69.2265,
      "confidence": 0.0,
      "duration": 11.07,
      "word_count": 20,
      "text": "Yesu akamwambia, “Amin, amin nakuambia, hakuna mtu yeyote anayeweza kuingia Ufalme wa Mungu kama hajazaliwa kwa maji na kwa Roho."
    },
    {
      "verse": 6,
      "start": 69.2265,
      "end": 73.8705,
      "confidence": 0.0,
      "duration": 4.6440000000000055,
      "word_count": 7,
      "text": "Mwili huzaa mwili, lakini Roho huzaa roho."
    },
    {
      "verse": 7,
      "start": 73.8705,
      "end": 98.243,
      "confidence": 0.0,
      "duration": 24.372499999999988,
      "word_count": 10,
      "text": "Kwa hiyo usishangae ninapokuambia huna budi ‘kuzaliwa mara ya pili.’"
    },
    {
      "verse": 8,
      "start": 98.243,
      "end": 108.508,
      "confidence": 0.0,
      "duration": 10.265,
      "word_count": 21,
      "text": "Upepo huvuma popote upendapo. Mvumo wake unausikia lakini huwezi ukafahamu utokako wala uendako. Ndivyo ilivyo kwa kila mtu aliyezaliwa na Roho.”"
    },
    {
      "verse": 9,
      "start": 108.508,
      "end": 108.868,
      "confidence": 0.0,
      "duration": 0.35999999999999943,
      "word_count": 5,
      "text": "Nikodemo akamuuliza, “Mambo haya yanawezekanaje?”"
    },
    {
      "verse": 10,
      "start": 108.868,
      "end": 108.918,
      "confidence": 0.0,
      "duration": 0.05000000000001137,
      "word_count": 12,
      "text": "Yesu akamwambia, “Wewe ni mwalimu mashuhuri wa Waisraeli, nawe huelewi mambo haya?"
    },
    {
      "verse": 11,
      "start": 108.918,
      "end": 120.852,
      "confidence": 0.0,
      "duration": 11.933999999999997,
      "word_count": 17,
      "text": "Amin, amin ninakuambia, sisi tunazungumza lile tunalolijua na tunashuhudia lile tuliloliona. Lakini ninyi watu hamkubali ushuhuda wetu."
    },
    {
      "verse": 12,
      "start": 120.852,
      "end": 130.136,
      "confidence": 0.0,
      "duration": 9.283999999999992,
      "word_count": 12,
      "text": "Nimewaambia mambo ya duniani, nanyi hamkuniamini, mtaniaminije basi nitakapowaambia mambo ya mbinguni?"
    },
    {
      "verse": 13,
      "start": 130.136,
      "end": 219.549,
      "confidence": 0.0,
      "duration": 89.41300000000001,
      "word_count": 14,
      "text": "Hakuna mtu yeyote aliyekwenda mbinguni isipokuwa yeye aliyeshuka kutoka mbinguni, yaani, Mwana wa Adamu."
    },
    {
      "verse": 14,
      "start": 219.549,
      "end": 220.678,
      "confidence": 0.0,
      "duration": 1.1289999999999907,
      "word_count": 17,
      "text": "Kama vile Mose alivyomwinua yule nyoka kule jangwani, vivyo hivyo Mwana wa Adamu hana budi kuinuliwa juu."
    },
    {
      "verse": 15,
      "start": 220.678,
      "end": 222.237,
      "confidence": 0.0,
      "duration": 1.5589999999999975,
      "word_count": 9,
      "text": "Ili kila mtu amwaminiye awe na uzima wa milele."
    },
    {
      "verse": 16,
      "start": 222.237,
      "end": 223.008,
      "confidence": 0.0,
      "duration": 0.771000000000015,
      "word_count": 23,
      "text": "“Kwa maana jinsi hii Mungu aliupenda ulimwengu hata akamtoa Mwanawe wa pekee, ili kila mtu amwaminiye asipotee, bali awe na uzima wa milele."
    },
    {
      "verse": 17,
      "start": 223.008,
      "end": 223.768,
      "confidence": 0.0,
      "duration": 0.7599999999999909,
      "word_count": 13,
      "text": "Kwa maana Mungu hakumtuma Mwanawe kuuhukumu ulimwengu, bali kupitia kwake ulimwengu upate kuokolewa."
    },
    {
      "verse": 18,
      "start": 223.768,
      "end": 223.949,
      "confidence": 0.0,
      "duration": 0.1810000000000116,
      "word_count": 16,
      "text": "Yeyote amwaminiye hahukumiwi, lakini asiyeamini amekwisha kuhukumiwa, kwa sababu hakuliamini jina la Mwana pekee wa Mungu."
    },
    {
      "verse": 19,
      "start": 223.949,
      "end": 224.079,
      "confidence": 0.0,
      "duration": 0.12999999999999545,
      "word_count": 19,
      "text": "Hii ndiyo hukumu kwamba: Nuru imekuja ulimwenguni, nao watu wakapenda giza kuliko nuru kwa sababu matendo yao ni maovu."
    },
    {
      "verse": 20,
      "start": 224.079,
      "end": 224.569,
      "confidence": 0.0,
      "duration": 0.4899999999999807,
      "word_count": 16,
      "text": "Kwa kuwa kila atendaye maovu huchukia nuru, wala haji kwenye nuru ili matendo yake maovu yasifichuliwe."
    },
    {
      "verse": 21,
      "start": 224.569,
      "end": 224.619,
      "confidence": 0.0,
      "duration": 0.05000000000001137,
      "word_count": 23,
      "text": "Lakini yule aishiye kwa ukweli huja kwenye nuru, ili ionekane wazi kwamba matendo yake yametendeka katika Mungu.” Ushuhuda Wa Yohana Mbatizaji Kuhusu Yesu"
    },
    {
      "verse": 22,
      "start": 224.619,
      "end": 230.9735,
      "confidence": 0.0,
      "duration": 6.354500000000002,
      "word_count": 19,
      "text": "Baada ya haya, Yesu na wanafunzi wake walikwenda katika nchi ya Uyahudi, nao wakakaa huko kwa muda na kubatiza."
    },
    {
      "verse": 23,
      "start": 230.9735,
      "end": 243.3515,
      "confidence": 0.0,
      "duration": 12.377999999999986,
      "word_count": 22,
      "text": "Yohana naye alikuwa akibatiza huko Ainoni karibu na Salimu kwa sababu huko kulikuwa na maji tele. Watu wazima wakamjia huko ili kubatizwa."
    },
    {
      "verse": 24,
      "start": 243.3515,
      "end": 247.676,
      "confidence": 0.0,
      "duration": 4.3245000000000005,
      "word_count": 6,
      "text": "g(Hii ilikuwa kabla Yohana hajatiwa gerezani)."
    },
    {
      "verse": 25,
      "start": 247.676,
      "end": 258.14,
      "confidence": 0.0,
      "duration": 10.463999999999999,
      "word_count": 20,
      "text": "Mashindano yakazuka kati ya baadhi ya wanafunzi wa Yohana na Myahudi mmoja kuhusu suala la desturi ya kunawa kwa utakaso."
    },
    {
      "verse": 26,
      "start": 258.14,
      "end": 272.9025,
      "confidence": 0.0,
      "duration": 14.762499999999989,
      "word_count": 23,
      "text": "Wakamwendea Yohana wakamwambia, “Rabi, yule mtu aliyekuwa pamoja nawe ng’ambo ya Mto Yordani, yule uliyeshuhudia habari zake, sasa anabatiza na kila mtu anamwendea!”"
    },
    {
      "verse": 27,
      "start": 272.9025,
      "end": 283.896,
      "confidence": 0.0,
      "duration": 10.99350000000004,
      "word_count": 15,
      "text": "Yohana akawajibu, “Hakuna mtu yeyote awezaye kupata kitu chochote isipokuwa kile tu alichopewa kutoka mbinguni."
    },
    {
      "verse": 28,
      "start": 283.896,
      "end": 291.5295,
      "confidence": 0.0,
      "duration": 7.6334999999999695,
      "word_count": 13,
      "text": "Ninyi wenyewe ni mashahidi wangu kwamba nilisema, ‘Mimi si Kristo,l ila nimetumwa nimtangulie.’"
    },
    {
      "verse": 29,
      "start": 291.5295,
      "end": 329.433,
      "confidence": 0.0,
      "duration": 37.90350000000001,
      "word_count": 31,
      "text": "Bibi arusi ni wa bwana arusi. Lakini rafiki yake bwana arusi anayesimama karibu naye na kusikiliza kutoka kwake, hufurahi sana aisikiapo sauti ya bwana arusi. Kwa sababu hii furaha yangu imekamilika."
    },
    {
      "verse": 30,
      "start": 329.433,
      "end": 329.553,
      "confidence": 0.0,
      "duration": 0.12000000000000455,
      "word_count": 14,
      "text": "Yeye hana budi kuwa mkuu zaidi na mimi nizidi kuwa mdogo.” Yeye Aliyetoka Mbinguni"
    },
    {
      "verse": 31,
      "start": 329.553,
      "end": 329.753,
      "confidence": 0.0,
      "duration": 0.19999999999998863,
      "word_count": 28,
      "text": "“Yeye ajaye kutoka juu yu juu ya yote, yeye aliye wa duniani ni wa dunia, naye huzungumza mambo ya duniani. Yeye aliyekuja kutoka mbinguni, yu juu ya yote."
    },
    {
      "verse": 32,
      "start": 329.753,
      "end": 330.3935,
      "confidence": 0.0,
      "duration": 0.6405000000000314,
      "word_count": 12,
      "text": "Yeye hushuhudia yale aliyoyaona na kuyasikia, lakini hakuna yeyote anayekubali ushuhuda wake."
    },
    {
      "verse": 33,
      "start": 330.3935,
      "end": 331.174,
      "confidence": 0.0,
      "duration": 0.7804999999999609,
      "word_count": 10,
      "text": "Lakini yeyote anayekubali huo ushuhuda anathibitisha kwamba, Mungu ni kweli."
    },
    {
      "verse": 34,
      "start": 331.174,
      "end": 331.374,
      "confidence": 0.0,
      "duration": 0.20000000000004547,
      "word_count": 15,
      "text": "Yeye aliyetumwa na Mungu husema maneno ya Mungu, kwa kuwa Mungu humtoa Roho pasipo kipimo."
    },
    {
      "verse": 35,
      "start": 331.374,
      "end": 331.534,
      "confidence": 0.0,
      "duration": 0.15999999999996817,
      "word_count": 9,
      "text": "Baba anampenda Mwana, naye ametia vitu vyote mikononi mwake."
    },
    {
      "verse": 36,
      "start": 331.534,
      "end": 331.804,
      "confidence": 0.0,
      "duration": 0.2699999999999818,
      "word_count": 25,
      "text": "Yeyote anayemwamini Mwana ana uzima wa milele, lakini yeye asiyemwamini Mwana hatauona uzima, bali ghadhabu ya Mungu itakuwa juu yake.” Yesu Azungumza Na Mwanamke Msamaria"
    }
  ]
}
